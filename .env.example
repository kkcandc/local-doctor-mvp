# Google Ads tag for trylocaldoctor.com.
# This app is Vite, so the client prefix is VITE_ (NEXT_PUBLIC_GOOGLE_ADS_ID is not read).
# Production builds already default to AW-18413556843. Set off to disable the tag.
# These are public ids, read at build time. Changing them requires a redeploy.
VITE_GOOGLE_ADS_ID=AW-18413556843

# Google Ads account 908-258-0886. Label only (the part after AW-18413556843/).
# Real values belong in Vercel Production and Preview. They are inlined at build time.
# Local Doctor - Lead Typeform → send_to AW-18413556843/KA47CJbG9LAdEOuoosxE
VITE_GOOGLE_ADS_LEAD_LABEL=KA47CJbG9LAdEOuoosxE
# Local Doctor - Phone click → send_to AW-18413556843/gJr-CJnG9LAdEOuoosxE
VITE_GOOGLE_ADS_PHONE_LABEL=gJr-CJnG9LAdEOuoosxE

# Google Analytics 4 measurement id. Same gtag.js load as Google Ads.
# Production builds already default to G-0NF3ZM8GFF. Set off, false, or 0 to omit GA4.
# Public id, read at build time. Changing it requires a redeploy.
# Page hits stay path/event-name only: no names, emails, phones, DOB, diagnoses, or form answers.
VITE_GA_MEASUREMENT_ID=G-0NF3ZM8GFF

# PostHog browser analytics. These public values are read at build time.
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://your-posthog-host
