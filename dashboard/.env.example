# Local Doctor marketing dashboard. Copy to .env.local for local dev.
# On Vercel, set these in Project Settings > Environment Variables.
# Never commit real values.

# --- Access (required) ---
# Shared password for the whole dashboard. Without it every page stays locked.
DASHBOARD_PASSWORD=
# Optional extra secret mixed into the session cookie signature. Any long random string.
SESSION_SECRET=
# Optional second password required only to save offline lead numbers.
OFFLINE_ENTRY_PASSWORD=

# --- Vercel Cron (required on Vercel) ---
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/refresh. Any long random string.
CRON_SECRET=

# --- Storage (required on Vercel) ---
# Added automatically when a Vercel Blob store is connected to the project.
# Without it, local dev stores files in dashboard/.data instead.
BLOB_READ_WRITE_TOKEN=

# --- Google Ads API ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) account used to log in, digits only.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1098010850
# Advertiser account to report on, digits only.
GOOGLE_ADS_CUSTOMER_ID=9082580886
# Optional. Defaults to v26.
GOOGLE_ADS_API_VERSION=

# --- GA4 Data API ---
GA4_PROPERTY_ID=562274971
# Full service account key JSON on one line, or the same JSON base64-encoded.
GA4_SERVICE_ACCOUNT_JSON=

# --- Optional ---
# Days of history pulled on each refresh (7 to 730). Default 400.
SNAPSHOT_LOOKBACK_DAYS=
# Time zone used to decide "yesterday" before the Ads account time zone is known. Default America/New_York.
DASHBOARD_TIMEZONE=
# Set to 1 to always show the bundled example data (useful for preview deployments).
USE_EXAMPLE_DATA=
