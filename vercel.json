{
  "redirects": [
    {
      "source": "/pilot-plan",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pilot-plan/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "exit 1"
}
