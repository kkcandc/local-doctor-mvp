{
  "redirects": [
    {
      "source": "/resources",
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/pilot-plan",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pilot-plan/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/leqembi/:state/:city",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/leqembi/:state/:city/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/leqembi",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/leqembi/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/leqembi/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/leqembi/:path*/",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "exit 1"
}
