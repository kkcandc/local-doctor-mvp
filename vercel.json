{
  "redirects": [
    {
      "source": "/resources",
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/blog/lecanemab-vs-aducanumab",
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/blog/lecanemab-vs-aducanumab/",
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/pilot-plan",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pilot-plan/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/leqembi/:state/:city",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/leqembi/:state/:city/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/leqembi",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/leqembi/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/leqembi/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/leqembi/:path*/",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap\\.xml$|robots\\.txt$).*)",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "exit 1"
}
